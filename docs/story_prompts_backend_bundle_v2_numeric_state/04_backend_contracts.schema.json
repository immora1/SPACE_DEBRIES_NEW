{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story-backend-contracts-v2.2",
  "title": "Story backend numeric-state and site-interaction contracts",
  "$defs": {
    "stateMetrics": {
      "type": "object",
      "properties": {
        "event_integrity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "relationship_connection": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "uncertainty": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "event_integrity",
        "relationship_connection",
        "uncertainty"
      ],
      "additionalProperties": false
    },
    "stateDelta": {
      "type": "object",
      "properties": {
        "event_integrity": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100
        },
        "relationship_connection": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100
        },
        "uncertainty": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100
        }
      },
      "required": [
        "event_integrity",
        "relationship_connection",
        "uncertainty"
      ],
      "additionalProperties": false
    },
    "consequence": {
      "type": "object",
      "properties": {
        "consequence_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "consequence_id",
        "description"
      ],
      "additionalProperties": false
    },
    "optionConfig": {
      "type": "object",
      "properties": {
        "option_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "effect_summary": {
          "type": "string",
          "minLength": 1
        },
        "state_delta": {
          "$ref": "#/$defs/stateDelta"
        },
        "add_consequence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "resolve_consequence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "key_outcome": {
          "type": "string"
        }
      },
      "required": [
        "option_id",
        "label",
        "effect_summary",
        "state_delta",
        "add_consequence_ids",
        "resolve_consequence_ids",
        "key_outcome"
      ],
      "additionalProperties": false
    },
    "nodeOptionSet": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/optionConfig"
          }
        }
      },
      "required": [
        "node_id",
        "options"
      ],
      "additionalProperties": false
    },
    "storyInteractionMode": {
      "type": "string",
      "enum": [
        "SITE_SINGLE",
        "SITE_GROUP_SINGLE",
        "SITE_COMPOSITE",
        "SITE_GAME_RESULT",
        "LEGACY_STORY_OPTION"
      ]
    },
    "materialKnowledgeProfile": {
      "type": "object",
      "properties": {
        "keywords": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "safe_facts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "design_tradeoffs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "debris_relevance": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "required": ["keywords", "safe_facts", "design_tradeoffs", "debris_relevance"],
      "additionalProperties": false
    },
    "missionKnowledgeProfile": {
      "type": "object",
      "properties": {
        "keywords": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "safe_facts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "mission_relevance": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "debris_relevance": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "operational_tradeoffs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "required": ["keywords", "safe_facts", "mission_relevance", "debris_relevance", "operational_tradeoffs"],
      "additionalProperties": false
    },
    "taskProfile": {
      "type": "object",
      "properties": {
        "objective_summary": { "type": "string", "minLength": 1 },
        "task_description": { "type": "string", "minLength": 1 },
        "orbit_or_range": { "type": "string", "minLength": 1 },
        "related_satellite": { "type": "string", "minLength": 1 },
        "related_payload": { "type": "string", "minLength": 1 }
      },
      "required": ["objective_summary"],
      "additionalProperties": false
    },
    "siteStoryBinding": {
      "type": "object",
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "module_id": { "type": "string", "minLength": 1 },
        "section_id": { "type": "string", "minLength": 1 },
        "control_id": { "type": "string", "minLength": 1 },
        "target_node_id": { "type": "string", "minLength": 1 },
        "interaction_mode": { "$ref": "#/$defs/storyInteractionMode" },
        "display_snapshot": {
          "type": "object",
          "properties": {
            "section_name": { "type": "string", "minLength": 1 },
            "option_name": { "type": "string", "minLength": 1 }
          },
          "required": ["section_name", "option_name"],
          "additionalProperties": false
        },
        "effect_summary": { "type": "string", "minLength": 1 },
        "state_delta": { "$ref": "#/$defs/stateDelta" },
        "add_consequence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "resolve_consequence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "key_outcome": { "type": "string" },
        "knowledge_profile": {
          "oneOf": [
            { "$ref": "#/$defs/materialKnowledgeProfile" },
            { "$ref": "#/$defs/missionKnowledgeProfile" }
          ]
        },
        "task_id": { "type": "string", "minLength": 1 },
        "task_name": { "type": "string", "minLength": 1 },
        "task_profile": { "$ref": "#/$defs/taskProfile" }
      },
      "required": [
        "binding_id", "module_id", "section_id", "control_id", "target_node_id",
        "interaction_mode", "display_snapshot", "effect_summary", "state_delta",
        "add_consequence_ids", "resolve_consequence_ids", "key_outcome"
      ],
      "additionalProperties": false
    },
    "siteInteractionRequestItem": {
      "type": "object",
      "properties": {
        "section_id": { "type": "string", "minLength": 1 },
        "control_id": { "type": "string", "minLength": 1 },
        "option_id": { "type": "string", "minLength": 1 }
      },
      "required": ["section_id", "control_id", "option_id"],
      "additionalProperties": false
    },
    "selectedSiteOptionSnapshot": {
      "type": "object",
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "module_id": { "type": "string", "minLength": 1 },
        "section_id": { "type": "string", "minLength": 1 },
        "section_name": { "type": "string", "minLength": 1 },
        "control_id": { "type": "string", "minLength": 1 },
        "option_id": { "type": "string", "minLength": 1 },
        "option_name": { "type": "string", "minLength": 1 },
        "task_id": { "type": "string", "minLength": 1 },
        "task_name": { "type": "string", "minLength": 1 },
        "target_node_id": { "type": "string", "minLength": 1 },
        "effect_summary": { "type": "string", "minLength": 1 },
        "state_delta": { "$ref": "#/$defs/stateDelta" },
        "add_consequence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "resolve_consequence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "key_outcome": { "type": "string" },
        "knowledge_profile": {
          "oneOf": [
            { "$ref": "#/$defs/materialKnowledgeProfile" },
            { "$ref": "#/$defs/missionKnowledgeProfile" }
          ]
        },
        "task_profile": { "$ref": "#/$defs/taskProfile" },
        "selected_at": { "type": "string", "format": "date-time" }
      },
      "required": [
        "binding_id", "module_id", "section_id", "section_name", "control_id",
        "option_id", "option_name", "target_node_id", "effect_summary", "state_delta",
        "add_consequence_ids", "resolve_consequence_ids", "key_outcome", "selected_at"
      ],
      "additionalProperties": false
    },
    "siteInteractionOutcome": {
      "type": "object",
      "properties": {
        "module_id": { "type": "string", "minLength": 1 },
        "section_id": { "type": "string", "minLength": 1 },
        "control_id": { "type": "string", "minLength": 1 },
        "option_id": { "type": "string", "minLength": 1 },
        "option_name": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 }
      },
      "required": ["module_id", "section_id", "control_id", "option_id", "option_name", "outcome"],
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "properties": {
        "current_situation": {
          "type": "string",
          "minLength": 1
        },
        "unresolved_threads": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "current_situation",
        "unresolved_threads"
      ],
      "additionalProperties": false
    },
    "legacyOptionContinueContext": {
      "type": "object",
      "properties": {
        "current_node": {
          "type": "object",
          "properties": {
            "node_id": {
              "enum": [
                "node_02",
                "node_03",
                "node_04"
              ]
            },
            "task_type": {
              "enum": [
                "STORY_CONTINUE"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "entry_condition": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "node_id",
            "task_type",
            "summary",
            "entry_condition"
          ],
          "additionalProperties": false
        },
        "selected_option_effect": {
          "type": "object",
          "properties": {
            "option_id": {
              "type": "string",
              "minLength": 1
            },
            "effect_summary": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "option_id",
            "effect_summary"
          ],
          "additionalProperties": false
        },
        "state_transition": {
          "type": "object",
          "properties": {
            "before": {
              "$ref": "#/$defs/stateMetrics"
            },
            "delta": {
              "$ref": "#/$defs/stateDelta"
            },
            "after": {
              "$ref": "#/$defs/stateMetrics"
            },
            "active_consequences": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/consequence"
              }
            }
          },
          "required": [
            "before",
            "delta",
            "after",
            "active_consequences"
          ],
          "additionalProperties": false
        },
        "previous_handoff": {
          "$ref": "#/$defs/handoff"
        },
        "story_context": {
          "type": "object",
          "properties": {
            "core_event": {
              "type": "string",
              "minLength": 1
            },
            "irreplaceable_part": {
              "type": "string",
              "minLength": 1
            },
            "primary_anomaly": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "core_event",
            "irreplaceable_part",
            "primary_anomaly"
          ],
          "additionalProperties": false
        },
        "known_to_user": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selected_game_answers": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "properties": {
              "question_id": { "type": "string", "minLength": 1 },
              "question_order": { "type": "integer", "minimum": 1, "maximum": 6 },
              "answer_id": { "type": "string", "minLength": 1 },
              "answer_name": { "type": "string", "minLength": 1 },
              "effect_summary": { "type": "string", "minLength": 1 }
            },
            "required": ["question_id", "question_order", "answer_id", "answer_name", "effect_summary"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "current_node",
        "selected_option_effect",
        "state_transition",
        "previous_handoff",
        "story_context",
        "known_to_user",
        "selected_game_answers"
      ],
      "additionalProperties": false
    },
    "siteInteractionContinueContext": {
      "type": "object",
      "properties": {
        "current_node": {
          "type": "object",
          "properties": {
            "node_id": {
              "enum": [
                "node_02",
                "node_03",
                "node_04"
              ]
            },
            "task_type": {
              "enum": [
                "STORY_CONTINUE"
              ]
            },
            "summary": { "type": "string", "minLength": 1 },
            "entry_condition": { "type": "string", "minLength": 1 }
          },
          "required": ["node_id", "task_type", "summary", "entry_condition"],
          "additionalProperties": false
        },
        "site_interactions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "section_id": { "type": "string", "minLength": 1 },
              "option_id": { "type": "string", "minLength": 1 },
              "effect_summary": { "type": "string", "minLength": 1 }
            },
            "required": [
              "section_id",
              "option_id",
              "effect_summary"
            ],
            "additionalProperties": false
          }
        },
        "state_transition": {
          "type": "object",
          "properties": {
            "before": { "$ref": "#/$defs/stateMetrics" },
            "combined_delta": { "$ref": "#/$defs/stateDelta" },
            "after": { "$ref": "#/$defs/stateMetrics" },
            "active_consequences": {
              "type": "array",
              "items": { "$ref": "#/$defs/consequence" }
            }
          },
          "required": [
            "before",
            "combined_delta",
            "after",
            "active_consequences"
          ],
          "additionalProperties": false
        },
        "previous_handoff": { "$ref": "#/$defs/handoff" },
        "story_context": {
          "type": "object",
          "properties": {
            "core_event": { "type": "string", "minLength": 1 },
            "irreplaceable_part": { "type": "string", "minLength": 1 },
            "primary_anomaly": { "type": "string", "minLength": 1 }
          },
          "required": ["core_event", "irreplaceable_part", "primary_anomaly"],
          "additionalProperties": false
        },
        "known_to_user": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": [
        "current_node",
        "site_interactions",
        "state_transition",
        "previous_handoff",
        "story_context",
        "known_to_user"
      ],
      "additionalProperties": false
    },
    "continueContext": {
      "oneOf": [
        { "$ref": "#/$defs/legacyOptionContinueContext" },
        { "$ref": "#/$defs/siteInteractionContinueContext" }
      ]
    },
    "endingContext": {
      "type": "object",
      "properties": {
        "current_node": {
          "type": "object",
          "properties": {
            "node_id": {
              "const": "node_05"
            },
            "task_type": {
              "const": "STORY_ENDING"
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "entry_condition": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "node_id",
            "task_type",
            "summary",
            "entry_condition"
          ],
          "additionalProperties": false
        },
        "selected_ending": {
          "type": "object",
          "properties": {
            "ending_id": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "ending_id",
            "outcome"
          ],
          "additionalProperties": false
        },
        "previous_handoff": {
          "$ref": "#/$defs/handoff"
        },
        "story_context": {
          "type": "object",
          "properties": {
            "core_event": {
              "type": "string",
              "minLength": 1
            },
            "user_expectation": {
              "type": "string",
              "minLength": 1
            },
            "irreplaceable_part": {
              "type": "string",
              "minLength": 1
            },
            "primary_anomaly": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "core_event",
            "user_expectation",
            "irreplaceable_part",
            "primary_anomaly"
          ],
          "additionalProperties": false
        },
        "story_state": {
          "$ref": "#/$defs/stateMetrics"
        },
        "active_consequences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/consequence"
          }
        },
        "key_outcomes": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "$ref": "#/$defs/siteInteractionOutcome" }
            ]
          }
        },
        "known_to_user": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "current_node",
        "selected_ending",
        "previous_handoff",
        "story_context",
        "story_state",
        "active_consequences",
        "key_outcomes",
        "known_to_user"
      ],
      "additionalProperties": false
    },
    "endingCondition": {
      "type": "object",
      "properties": {
        "metric": {
          "enum": [
            "event_integrity",
            "relationship_connection",
            "uncertainty"
          ]
        },
        "operator": {
          "enum": [
            "gte",
            "lte",
            "gt",
            "lt",
            "eq"
          ]
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "metric",
        "operator",
        "value"
      ],
      "additionalProperties": false
    },
    "endingRule": {
      "type": "object",
      "properties": {
        "priority": {
          "type": "integer"
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endingCondition"
          }
        },
        "required_consequence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "forbidden_consequence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "fallback": {
          "type": "boolean"
        }
      },
      "required": [
        "priority",
        "conditions",
        "required_consequence_ids",
        "forbidden_consequence_ids",
        "fallback"
      ],
      "additionalProperties": false
    },
    "knowledgeContext": {
      "type": "object",
      "properties": {
        "current_node": {
          "type": "object",
          "properties": {
            "node_id": {
              "const": "node_10"
            },
            "task_type": {
              "const": "KNOWLEDGE_REVEAL"
            },
            "summary": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "node_id",
            "task_type",
            "summary"
          ],
          "additionalProperties": false
        },
        "primary_anomaly": {
          "type": "string",
          "minLength": 1
        },
        "hidden_facts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ending_summary": {
          "type": "string",
          "minLength": 1
        },
        "next_node_context": {
          "type": "string",
          "minLength": 1
        },
        "story_anomaly_effects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selected_site_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "module_id": { "type": "string", "minLength": 1 },
              "section_id": { "type": "string", "minLength": 1 },
              "section_name": { "type": "string", "minLength": 1 },
              "option_id": { "type": "string", "minLength": 1 },
              "option_name": { "type": "string", "minLength": 1 },
              "knowledge_profile": {
                "type": "object",
                "properties": {
                  "keywords": { "type": "array", "items": { "type": "string" } },
                  "safe_facts": { "type": "array", "items": { "type": "string" } },
                  "design_tradeoffs": { "type": "array", "items": { "type": "string" } },
                  "debris_relevance": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["keywords", "safe_facts", "design_tradeoffs", "debris_relevance"],
                "additionalProperties": false
              }
            },
            "required": [
              "module_id",
              "section_id",
              "section_name",
              "option_id",
              "option_name",
              "knowledge_profile"
            ],
            "additionalProperties": false
          }
        },
        "selected_game_answers": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "properties": {
              "question_id": { "type": "string", "minLength": 1 },
              "question_order": { "type": "integer", "minimum": 1, "maximum": 6 },
              "answer_id": { "type": "string", "minLength": 1 },
              "answer_name": { "type": "string", "minLength": 1 },
              "knowledge_profile": {
                "type": "object",
                "properties": {
                  "keywords": { "type": "array", "items": { "type": "string" } },
                  "safe_facts": { "type": "array", "items": { "type": "string" } },
                  "decision_tradeoffs": { "type": "array", "items": { "type": "string" } },
                  "debris_relevance": { "type": "array", "items": { "type": "string" } },
                  "operational_relevance": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["keywords", "safe_facts", "decision_tradeoffs", "debris_relevance", "operational_relevance"],
                "additionalProperties": false
              }
            },
            "required": ["question_id", "question_order", "answer_id", "answer_name", "knowledge_profile"],
            "additionalProperties": false
          }
        },
